{
  "name": "aify-env",
  "version": "0.9.10-dev",
  "description": "The environment tier: owns processes and PTYs on one host, so more than one service can start agents without two spawners fighting over the same terminals.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "aify-env": "./bin/aify-env.mjs"
  },
  "files": [
    "lib/",
    "bin/",
    "docs/",
    "VERSION",
    "README.md"
  ],
  "aifyWrapper": "github:zimdin12/aify-wrapper#825bc814bbcc9f934905f60c112dbc0e2c0d1cf8",
  "scripts": {
    "test": "node tests/run-in-a-temp-root.mjs"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0",
    "@xterm/headless": "5.5.0",
    "@xterm/addon-unicode11": "0.8.0",
    "@xterm/addon-serialize": "0.13.0",
    "koffi": "3.3.3"
  },
  "exports": {
    "./package.json": "./package.json",
    "./service-plugins": "./lib/service-plugins.mjs",
    "./plugin-bootstrap": "./lib/plugin-bootstrap.mjs",
    "./start-spec": "./lib/start-spec.mjs",
    "./runner": "./lib/runner.mjs",
    "./process-registry": "./lib/process-registry.mjs",
    "./allowlist": "./lib/allowlist.mjs",
    "./interpreter": "./lib/interpreter.mjs",
    "./host-wsl": "./lib/host-wsl.mjs"
  }
}
